{
  "name": "dsh-plugin-chat-export",
  "version": "0.2.0",
  "type": "module",
  "description": "Group-chat export for DeepSeek Harness: a per-chat allowlist gate, Telegram fetch and WhatsApp import, and local-model digests that keep verbatim quotes separate from generated summaries.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "telegram",
    "whatsapp",
    "export",
    "digest"
  ],
  "license": "MIT",
  "author": "wth373737",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wth373737/dsh-plugin-chat-export.git"
  },
  "bugs": {
    "url": "https://github.com/wth373737/dsh-plugin-chat-export/issues"
  },
  "homepage": "https://github.com/wth373737/dsh-plugin-chat-export#readme",
  "scripts": {
    "check": "node tools/check-client-id.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "bridge/tg_bridge.py",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}